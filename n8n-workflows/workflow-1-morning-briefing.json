    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.*, array_agg(i.*) as recent_interactions FROM contacts c LEFT JOIN interactions i ON i.contact_id = c.id WHERE c.user_id = '00000000-0000-0000-0000-000000000001' OR c.user_id = 'philip' GROUP BY c.id ORDER BY c.updated_at DESC LIMIT 20;",
        "additionalFields": {}
      },
      "id": "postgres-fetch",
      "name": "Postgres: fetch open conversations and follow-ups",
