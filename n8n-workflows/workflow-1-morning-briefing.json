      "id": "http-briefing",
      "name": "HTTP Request: POST /agent/briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate response structure\nconst response = $input.first().json;\nif (!response.briefing && !response.summary) {\n  throw new Error('Invalid briefing response structure');\n}\nconst briefing = response.briefing || response;\nreturn {\n  json: {\n    valid: true,\n    briefing,\n    itemCount: briefing.items?.length || 0\n  }\n};"
      },
      "id": "code-validate",
      "name": "Code: validate response structure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
